+void AddressSpace::FastDispatchFill(IR::LocationDescriptor descriptor, CodePtr code_ptr) {
+    FastDispatchEntry& entry = fast_dispatch[FastDispatchIndex(descriptor.Value())];
+    entry.key = descriptor.Value();
+    entry.code = mcl::bit_cast<u64>(code_ptr);
+}
+
+void AddressSpace::FastDispatchInvalidate(IR::LocationDescriptor descriptor) {
+    FastDispatchEntry& entry = fast_dispatch[FastDispatchIndex(descriptor.Value())];
+    if (entry.key == descriptor.Value()) {
+        entry.key = FastDispatchEmptyKey;
+        entry.code = 0;
+    }
+}
+
+void AddressSpace::FastDispatchClear() {
